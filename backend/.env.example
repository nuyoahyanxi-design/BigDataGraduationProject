# Reference only: export variables securely; this file is not automatically loaded.
# WSL MYSQL_HOST is the Windows host gateway; existing activation script resolves it.
MYSQL_HOST=windows-host-address
MYSQL_PORT=3306
MYSQL_DATABASE=bigdata_graduation
MYSQL_USER=bigdata_dev
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4
# Required for direct uvicorn startup; developer run.py loads it from Windows vault.
JWT_SECRET=
# Optional absolute path; defaults to project outputs/recommendation-latest.json.
RECOMMENDATION_MANIFEST_PATH=
DASHBOARD_MANIFEST_PATH=
# Optional P2 assistant. Never put these values in VITE_* or Git.
AI_ASSISTANT_ENABLED=false
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=
AGNES_MODEL=
# Explicitly approved self-authored published resource IDs; empty denies resource context.
AI_ALLOWED_RESOURCE_IDS=
AI_TOTAL_TIMEOUT_SECONDS=45
AI_USER_DAILY_REQUEST_LIMIT=20
AI_GLOBAL_DAILY_REQUEST_LIMIT=100
AI_MAX_CONCURRENT_REQUESTS=2
